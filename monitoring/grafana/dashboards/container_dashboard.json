{
    "title":  "Container Resources",
    "uid":  "container-resources",
    "timezone":  "browser",
    "refresh":  "10s",
    "panels":  [
                   {
                       "id":  1,
                       "title":  "CPU Usage per Container (%)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  0,
                                       "w":  24,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(container_cpu_usage_seconds_total{name!=\"\"}[2m]) * 100",
                                           "legendFormat":  "{{ name }}",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "PB125CF2E8749F955"
                                                          }
                                       }
                                   ],
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "PB125CF2E8749F955"
                                      }
                   },
                   {
                       "id":  2,
                       "title":  "Memory Usage per Container (MB)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  8,
                                       "w":  24,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "container_memory_usage_bytes{name!=\"\"} / 1024 / 1024",
                                           "legendFormat":  "{{ name }}",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "PB125CF2E8749F955"
                                                          }
                                       }
                                   ],
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "PB125CF2E8749F955"
                                      }
                   },
                   {
                       "id":  3,
                       "title":  "Network I/O per Container (bytes/s)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "x":  0,
                                       "y":  16,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "rate(container_network_receive_bytes_total{name!=\"\"}[1m])",
                                           "legendFormat":  "{{ name }} rx",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "PB125CF2E8749F955"
                                                          }
                                       },
                                       {
                                           "expr":  "rate(container_network_transmit_bytes_total{name!=\"\"}[1m])",
                                           "legendFormat":  "{{ name }} tx",
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "PB125CF2E8749F955"
                                                          }
                                       }
                                   ],
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "PB125CF2E8749F955"
                                      }
                   },
                   {
                       "id":  4,
                       "title":  "Container Restarts",
                       "type":  "stat",
                       "gridPos":  {
                                       "x":  12,
                                       "y":  16,
                                       "w":  12,
                                       "h":  8
                                   },
                       "targets":  [
                                       {
                                           "expr":  "changes(container_start_time_seconds{name!=\"\"}[1h])",
                                           "legendFormat":  "{{ name }}",
                                           "instant":  true,
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "PB125CF2E8749F955"
                                                          }
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "thresholds":  {
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  0
                                                                                             },
                                                                                             {
                                                                                                 "color":  "yellow",
                                                                                                 "value":  1
                                                                                             },
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  3
                                                                                             }
                                                                                         ]
                                                                           }
                                                        }
                                       },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "PB125CF2E8749F955"
                                      }
                   }
               ],
    "schemaVersion":  38
}